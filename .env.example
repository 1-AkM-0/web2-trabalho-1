# MongoDB Atlas (item A)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Em desenvolvimento local use, por exemplo, web2-trabalho-1-dev.
# Na Vercel (produção) use web2-trabalho-1.
MONGODB_DB=web2-trabalho-1

# Cloudinary (item B)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret
CLOUDINARY_FOLDER=web2-trabalho-1
